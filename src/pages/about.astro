---
// The About text is in src/content/pages/about.md. This file only sets the layout.
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";

const page = await getEntry("pages", "about");
if (!page) throw new Error("Missing src/content/pages/about.md");
const { Content } = await render(page);
---
<Base title="About" description={page.data.description}>
  <section class="wrap page-head page-head-center">
    <h1>{page.data.title}</h1>
  </section>
  <section class="wrap prose prose-full prose-large">
    <Content />
  </section>
</Base>
