---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { site } from "../../../site.config";

export async function getStaticPaths() {
  const apps = await getCollection("apps");
  return apps.map((app) => ({ params: { slug: app.id }, props: { app } }));
}
const { app } = Astro.props;
const d = app.data;
const subject = encodeURIComponent(`${d.name} support`);
---
<Base title={`${d.name} Support`} description={`Get help with ${d.name}.`}>
  <section class="wrap page-head">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/apps/">Apps</a> / <a href={`/apps/${app.id}/`}>{d.name}</a> / <span aria-current="page">Support</span></nav>
    <h1>{d.name} Support</h1>
    <p class="lede">Found a bug or a number that looks wrong? Email us and include your device, iOS version and the inputs you used.</p>
    <a class="btn" href={`mailto:${site.email}?subject=${subject}`}>Email Support</a>
  </section>
  {d.faq.length > 0 && (
    <section class="wrap section" aria-labelledby="faq-heading">
      <div class="section-head"><h2 id="faq-heading">Common Questions</h2></div>
      <div class="faq">
        {d.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}
</Base>
